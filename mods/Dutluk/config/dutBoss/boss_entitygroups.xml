<?xml version="1.0" encoding="utf-8"?>

<configs>
  <append xpath="/entitygroups">

		<entitygroup name="dutSpiderBoss">dutSpiderBoss</entitygroup>
		<entitygroup name="dutVultureBoss">dutVultureBoss</entitygroup>
		<entitygroup name="dutDireWolfBoss">dutDireWolfBoss</entitygroup>

		<!-- Spawning için TEK boss grupları - SADECE 1 BOSS SPAWN OLACAK -->
		<entitygroup name="dutSpiderBossGroup">dutSpiderBoss</entitygroup>
		<entitygroup name="dutVultureBossGroup">dutVultureBoss</entitygroup>
		<entitygroup name="dutDireWolfBossGroup">dutDireWolfBoss</entitygroup>

		<!-- Karışık Boss Grubu - Sadece 1 boss seçilecek -->
		<entitygroup name="mixedBossGroup" count="1,1">
			dutSpiderBoss, 1
			dutVultureBoss, 1
			dutDireWolfBoss, 1
		</entitygroup>

		<!-- Boss encounter - Legendary Spider + az destekçi -->
		<entitygroup name="bossSpiderGroup" count="1,2">
			dutSpiderBoss, .7
			zombieSpiderApocalyptic, .2
			zombieSpiderCorrupted, .1
		</entitygroup>

		<!-- Boss encounter - Legendary Vulture + az destekçi -->
		<entitygroup name="bossVultureGroup" count="1,2">
			dutVultureBoss, .7
			animalZombieVulture, .2
			animalZombieVultureRadiated, .1
		</entitygroup>

		<!-- Boss encounter - Legendary Dire Wolf + az destekçi -->
		<entitygroup name="bossDireWolfGroup" count="1,2">
			dutDireWolfBoss, .7
			animalDireWolf, .3
		</entitygroup>

		<!-- Ultimate Boss Encounter - 1 boss + destekçiler -->
		<entitygroup name="ultimateBossEncounter" count="1,3">
			dutSpiderBoss, .4
			zombieSpiderApocalyptic, .3
			zombieSpiderCorrupted, .2
			zombieBusinessManApocalyptic, .1
		</entitygroup>

		<!-- Ultimate Boss Challenge - SADECE 1 BOSS -->
		<entitygroup name="ultimateBossChallenge" count="1,1">
			dutSpiderBoss, 1
			dutVultureBoss, 1
			dutDireWolfBoss, 1
		</entitygroup>

  </append>
</configs>
