<?xml version="1.0" encoding="UTF-8"?>

<configs>
  <append xpath="/gameevents">

    <!-- Dutluk: Periodic boss spawn action sequence. This emulates airdrop-style orchestration. -->
    <action_sequence name="dut_boss_event">
      <property name="allow_user_trigger" value="true" />
      <property name="action_type" value="Game" />

      <!-- Find a nearby safe point to spawn around the triggering player -->
      <action class="GetNearbyPoint">
        <property name="min_distance" value="200" />
        <property name="max_distance" value="800" />
        <property name="safe_spawn" value="true" />
      </action>

      <!-- Small delay for pacing -->
      <action class="Delay">
        <property name="time" value="2" />
      </action>

      <!-- Spawn a single boss from the mixed group at the computed position -->
      <action class="SpawnEntity">
        <property name="entity_group" value="mixedBossGroup" />
        <property name="spawn_count" value="1" />
        <property name="spawn_type" value="NearPosition" />
        <property name="safe_spawn" value="true" />
        <property name="single_choice" value="true" />
        <property name="clear_position_on_complete" value="true" />
        <property name="is_aggressive" value="true" />
      </action>

      <!-- Optional: notify players with a sound cue; can add ChatNotify if desired -->
      <action class="PlaySound"><property name="sound" value="supply_drop" /></action>
    </action_sequence>

  </append>
</configs>
