<?xml version="1.0" encoding="utf-8"?>

<configs>

  <append xpath="/gamestages">

		<group name="dutSpiderBoss" spawner="dutSpiderBoss"/>
		<group name="dutVultureBoss" spawner="dutVultureBoss"/>
		<group name="dutDireWolfBoss" spawner="dutDireWolfBoss"/>

		<group name="ultimateBossChallenge" spawner="BossChallenge"/>
		<group name="bossSpiderGroup" spawner="BossSpiderGroup"/>
		<group name="bossVultureGroup" spawner="BossVultureGroup"/>
		<group name="bossDireWolfGroup" spawner="BossDireWolfGroup"/>
		<group name="mixedBossGroup" spawner="BossChallenge"/>


		<!-- Boss Level - Legendary Spider spawner -->
		<spawner name="dutSpiderBoss">
			<gamestage stage="1">
				<spawn group="dutSpiderBoss" duration="10"/>
			</gamestage>
		</spawner>

		<!-- Boss Level - Legendary Vulture spawner -->
		<spawner name="dutVultureBoss">
			<gamestage stage="1">
				<spawn group="dutVultureBoss" duration="10"/>
			</gamestage>
		</spawner>

		<!-- Boss Level - Legendary Dire Wolf spawner -->
		<spawner name="dutDireWolfBoss">
			<gamestage stage="1">
				<spawn group="dutDireWolfBoss" duration="10"/>
			</gamestage>
		</spawner>


		<spawner name="BossSpiderGroup">
			<gamestage stage="300">
				<spawn group="bossSpiderGroup" num="1" maxAlive="1" duration="10"/>
			</gamestage>
		</spawner>

		<spawner name="BossVultureGroup">
			<gamestage stage="300">
				<spawn group="bossVultureGroup" num="1" maxAlive="1" duration="10"/>
			</gamestage>
		</spawner>

		<spawner name="BossDireWolfGroup">
			<gamestage stage="300">
				<spawn group="bossDireWolfGroup" num="1" maxAlive="1" duration="10"/>
			</gamestage>
		</spawner>

		<!-- Boss Challenge Spawner - Özel boss etkinlikleri için -->
		<spawner name="BossChallenge">
			<gamestage stage="300">
				<spawn group="bossSpiderGroup" num="1" maxAlive="1" duration="10"/>
			</gamestage>
			<gamestage stage="400">
				<spawn group="bossVultureGroup" num="1" maxAlive="1" duration="10"/>
			</gamestage>
			<gamestage stage="500">
				<spawn group="bossDireWolfGroup" num="1" maxAlive="1" duration="10"/>
			</gamestage>
		</spawner>

  </append>
</configs>
