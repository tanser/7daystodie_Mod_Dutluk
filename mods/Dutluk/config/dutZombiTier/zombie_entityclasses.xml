<?xml version="1.0" encoding="UTF-8"?>

<configs>
  <append xpath="/entity_classes">

		<!-- Yeni zorluk seviyeleri için renk tanımları -->
		<!-- Purple (Mor) - Charged'dan daha güçlü -->
		<color name="corrupted" value="1.5,0,2.5, .8"/> <!-- Purple, emissive power .8 -->
		
		<!-- Red (Kırmızı) - En güçlü seviye (Infernal yerine gerçek kırmızı) -->
		<color name="apocalyptic" value="3,0,0, .9"/> <!-- Pure Red, emissive power .9 -->

		<!-- Boss seviyesi - Altın sarı renk -->
		<color name="legendary" value="3,2.5,0, 1.0"/> <!-- Golden, maximum emissive power -->





		<!-- Örnek zombi türleri için yeni zorluk varyantları -->
		
		<!-- Arlene Corrupted -->
		<entity_class name="zombieArleneCorrupted" extends="zombieArleneCharged">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="corrupted"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,corrupted"/>
			<property name="ExperienceGain" value="2000"/><!-- XP Corrupted -->
			<property name="HandItem" value="meleeHandZombieCorrupted"/>
			<property name="MoveSpeedAggro" value="2.5, .9, .8, 1.8, 1.1, .7, .4, 1.8"/>
			<property name="JumpMaxDistance" value="4.5, 6.5"/> <!-- Daha uzun zıplama -->
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2000"/>
			</effect_group>
		</entity_class>

		<!-- Arlene Apocalyptic -->
		<entity_class name="zombieArleneApocalyptic" extends="zombieArleneCorrupted">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="apocalyptic"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,apocalyptic"/>
			<property name="ExperienceGain" value="2800"/><!-- XP Apocalyptic -->
			<property name="HandItem" value="meleeHandZombieApocalyptic"/>
			<property name="MoveSpeedAggro" value="4, .98, 1.2, .6, 1.3, .5, .3, 2.0"/>
			<property name="JumpMaxDistance" value="5.0, 7.0"/> <!-- En uzun zıplama -->
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2600"/>
			</effect_group>
		</entity_class>

		<!-- BusinessMan Corrupted -->
		<entity_class name="zombieBusinessManCorrupted" extends="zombieBusinessManCharged">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="corrupted"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,corrupted"/>
			<property name="ExperienceGain" value="2100"/><!-- XP Corrupted -->
			<property name="HandItem" value="meleeHandZombieCorrupted"/>
			<property name="MoveSpeedAggro" value="2.5, .9, .8, 1.8, 1.1, .7, .4, 1.8"/>
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2250"/>
			</effect_group>
		</entity_class>

		<!-- BusinessMan Apocalyptic -->
		<entity_class name="zombieBusinessManApocalyptic" extends="zombieBusinessManCorrupted">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="apocalyptic"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,apocalyptic"/>
			<property name="ExperienceGain" value="2900"/><!-- XP Apocalyptic -->
			<property name="HandItem" value="meleeHandZombieApocalyptic"/>
			<property name="MoveSpeedAggro" value="4, .98, 1.2, .6, 1.3, .5, .3, 2.0"/>
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2925"/>
			</effect_group>
		</entity_class>

		<!-- Joe Corrupted -->
		<entity_class name="zombieJoeCorrupted" extends="zombieJoeCharged">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="corrupted"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,corrupted"/>
			<property name="ExperienceGain" value="2000"/><!-- XP Corrupted -->
			<property name="HandItem" value="meleeHandZombieCorrupted"/>
			<property name="MoveSpeedAggro" value="2.5, .9, .8, 1.8, 1.1, .7, .4, 1.8"/>
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2000"/>
			</effect_group>
		</entity_class>

		<!-- Joe Apocalyptic -->
		<entity_class name="zombieJoeApocalyptic" extends="zombieJoeCorrupted">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="apocalyptic"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,apocalyptic"/>
			<property name="ExperienceGain" value="2800"/><!-- XP Apocalyptic -->
			<property name="HandItem" value="meleeHandZombieApocalyptic"/>
			<property name="MoveSpeedAggro" value="4, .98, 1.2, .6, 1.3, .5, .3, 2.0"/>
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2600"/>
			</effect_group>
		</entity_class>

		<!-- Boe Corrupted -->
		<entity_class name="zombieBoeCorrupted" extends="zombieBoeCharged">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="corrupted"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,corrupted"/>
			<property name="ExperienceGain" value="2200"/><!-- XP Corrupted -->
			<property name="HandItem" value="meleeHandZombieCorrupted"/>
			<property name="MoveSpeedAggro" value="2.5, .9, .8, 1.8, 1.1, .7, .4, 1.8"/>
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="3125"/>
			</effect_group>
		</entity_class>

		<!-- Boe Apocalyptic -->
		<entity_class name="zombieBoeApocalyptic" extends="zombieBoeCorrupted">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="apocalyptic"/>
			<property name="Tags" value="entity,zombie,walker,allbiome,feral,apocalyptic"/>
			<property name="ExperienceGain" value="3100"/><!-- XP Apocalyptic -->
			<property name="HandItem" value="meleeHandZombieApocalyptic"/>
			<property name="MoveSpeedAggro" value="4, .98, 1.2, .6, 1.3, .5, .3, 2.0"/>
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="4063"/>
			</effect_group>
		</entity_class>

		<!-- Spider Corrupted -->
		<entity_class name="zombieSpiderCorrupted" extends="zombieSpiderCharged">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="corrupted"/>
			<property name="Tags" value="entity,zombie,spider,allbiome,feral,corrupted"/>
			<property name="ExperienceGain" value="2300"/><!-- XP Corrupted -->
			<property name="HandItem" value="meleeHandZombieCorrupted"/>
			<property name="MoveSpeedAggro" value="2.5, .9, .8, 1.8, 1.1, .7, .4, 1.8"/>
			<property name="JumpMaxDistance" value="6.0, 8.0"/> <!-- Spider için daha uzun zıplama -->
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="2750"/>
			</effect_group>
		</entity_class>

		<!-- Spider Apocalyptic -->
		<entity_class name="zombieSpiderApocalyptic" extends="zombieSpiderCorrupted">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="apocalyptic"/>
			<property name="Tags" value="entity,zombie,spider,allbiome,feral,apocalyptic"/>
			<property name="ExperienceGain" value="3200"/><!-- XP Apocalyptic -->
			<property name="HandItem" value="meleeHandZombieApocalyptic"/>
			<property name="MoveSpeedAggro" value="4, .98, 1.2, .6, 1.3, .5, .3, 2.0"/>
			<property name="JumpMaxDistance" value="6.5, 8.5"/> <!-- En uzun spider zıplaması -->
			
			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="3575"/>
			</effect_group>
		</entity_class>

		<!-- BOSS LEVEL: Legendary Spider - Altın renk, ultra güçlü -->
		<entity_class name="zombieSpiderLegendary" extends="zombieSpiderApocalyptic">
			<property name="UserSpawnType" value="Menu"/>
			<property name="MatColor" value="legendary"/>
			<property name="Tags" value="entity,zombie,spider,allbiome,feral,legendary,boss"/>
			<property name="HandItem" value="meleeHandZombieLegendary"/>
			<property name="MoveSpeedAggro" value="5, 1.0, 1.5, .4, 1.5, .3, .2, 2.5"/>
			<property name="JumpMaxDistance" value="8.0, 12.0"/> <!-- Boss seviyesi zıplama -->
			<property name="SizeScale" value="2"/> <!-- %200 daha büyük -->
			<property name="Mass" value="120"/> <!-- Daha ağır -->
			
			<property name="ExperienceGain" value="50000"/><!-- XP Boss -->
			<property name="LootDropEntityClass" value="EntityLootContainerLegendary"/>
			<property name="LootDropProb" value=".8"/> 

			<effect_group>
				<passive_effect name="HealthMax" operation="base_set" value="7500"/>
				<!-- Boss özel yetenekleri -->
				<passive_effect name="BuffResistance" operation="base_set" value=".85" tags="buffInjuryKnockdown01,buffInjuryKnockdown02"/>
				<passive_effect name="BuffResistance" operation="base_set" value=".80" tags="buffInjuryStunned01,buffInjuryStunned02,buffInjuryStunned03"/>
			</effect_group>
		</entity_class>


		<!-- BOSS LEVEL: Legendary Vulture - Altın renk, ultra güçlü -->
		<entity_class name="animalVultureLegendary" extends="animalZombieVulture">
			<property name="UserSpawnType" value="Menu"/>
			<property name="Tags" value="entity,animal,zombie,zombieAnimal,hostile,radiated,vulture"/>
			<property name="Mass" value="150"/>
			<property name="SizeScale" value="3.5"/>
			<!--<property name="ParticleOnSpawn" value="@:ParticleEffects/RadiatedParticlesOnMesh.prefab" param1="SetShapeToMesh0"/>-->

			<property name="MoveSpeed" value="1.3"/>
			<property name="MoveSpeedAggro" value="2.1, 2.7"/>
			<property name="MaxTurnSpeed" value="200"/>

			<property name="HandItem" value="meleeHandAnimalZombieVultureRadiated"/>

			<property name="ExperienceGain" value="50000"/><!-- XP Vulture Radiated -->

			<property name="DeadBodyHitPoints" value="300"/>
			<drop event="Harvest" name="foodRawMeat" count="0" tool_category="Butcher"/>
			<drop event="Harvest" name="foodRottingFlesh" tag="butcherHarvest" count="12"/> <!-- animalZombieVultureRadiated -->
			<drop event="Harvest" name="resourceFeather" tag="butcherHarvest" count="70"/>
			<drop event="Harvest" name="resourceBone" tag="butcherHarvest" count="16"/>
			<drop event="Harvest" name="resourceBone" tag="allToolsHarvest" count="10"/>

			<effect_group name="Base Effects">
				<passive_effect name="HealthMax" operation="base_set" value="3000"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="2"/> <!-- Feral damage -->
				<triggered_effect trigger="onOtherDamagedSelf" action="ModifyCVar" target="self" cvar="RadiatedRegenAmount" operation="set" value="4"/>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="self" buff="buffRadiatedRegen"/>
			</effect_group>
		</entity_class>

		<!-- BOSS LEVEL: Legendary Dire Wolf - Altın renk, ultra güçlü -->
		<entity_class name="animalDireWolfLegendary" extends="animalDireWolf">
			<property name="UserSpawnType" value="Menu"/>
			<property name="EntityFlags" value="animal,zombie"/>
			<property name="MatColor" value="legendary"/>
			<property name="Tags" value="entity,animal,zombie,zombieAnimal,hostile,wolf,perkAT05,legendary,boss"/>
			<property name="HandItem" value="meleeHandAnimalDireWolf"/>
			<property name="SizeScale" value="3.5"/> <!-- %200 daha büyük -->
			<property name="Mass" value="300"/>
			<property name="SightRange" value="140"/>

			<property name="AISeeOffset" value="1.5"/>
			<property name="AIPathCostScale" value=".35, .5"/>

			<property name="MoveSpeedAggro" value="2, 2.1"/>
			<property name="JumpMaxDistance" value="8, 12"/>


			<property name="ExperienceGain" value="50000"/><!-- XP Boss -->
			<property name="LootDropEntityClass" value="EntityLootContainerLegendary"/>
			<property name="LootDropProb" value=".8"/> <!-- Dire Wolf -->


			<property name="PainResistPerHit" value=".97"/>
			<property name="DeadBodyHitPoints" value="2000"/>

			<drop event="Harvest" name="foodRawMeat" count="0" tool_category="Butcher"/>
			<drop event="Harvest" name="foodRottingFlesh" tag="butcherHarvest" count="50"/> <!-- animalDireWolf -->
			<drop event="Harvest" name="resourceLeather" tag="butcherHarvest" count="20"/>
			<drop event="Harvest" name="resourceAnimalFat" tag="butcherHarvest" count="10"/>
			<drop event="Harvest" name="resourceBone" tag="butcherHarvest" count="20"/>
			<drop event="Harvest" name="resourceBone" tag="allToolsHarvest" count="10"/>

			<effect_group name="Base Effects">
				<passive_effect name="HealthMax" operation="base_set" value="10000"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="2"/> <!-- Feral damage -->
			</effect_group>
		</entity_class>

  </append>
</configs>
