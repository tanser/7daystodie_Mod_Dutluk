			<property name="ExperienceGain" value="2000"/><!-- XP Corrupted -->
			<property name="HandItem" value="meleeHandZombieCorrupted"/>
			<property name="MoveSpeedPattern" value="3, .95, 1, .75"/>	
			<property name="LootDropProb" value=".2"/>
			<property name="LootDropEntityClass" value="EntityLootContainerStrong"/>
			
			<effect_group name="Base Effects">
